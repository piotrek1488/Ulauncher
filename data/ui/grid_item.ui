<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.16"/>
  <!-- interface-local-resource-path ../media -->
  <object class="GridItemWidget" id="item-frame">
    <property name="name">item_frame</property>
    <property name="visible">True</property>
    <property name="can-focus">False</property>
    <child>
      <object class="GtkEventBox" id="item-box">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="margin-left">3</property>
        <property name="margin-right">3</property>
        <property name="margin-top">3</property>
        <property name="margin-bottom">3</property>
        <child>
          <object class="GtkBox" id="item-container">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="margin-left">4</property>
            <property name="margin-right">4</property>
            <property name="margin-top">8</property>
            <property name="margin-bottom">8</property>
            <property name="halign">center</property>
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkImage" id="item-icon">
                <property name="width-request">48</property>
                <property name="height-request">48</property>
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="halign">center</property>
                <property name="stock">gtk-missing-image</property>
                <style>
                  <class name="item-icon"/>
                  <class name="grid-item-icon"/>
                </style>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkLabel" id="item-name">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="margin-top">6</property>
                <property name="halign">center</property>
                <property name="justify">center</property>
                <property name="wrap">True</property>
                <property name="wrap-mode">word-char</property>
                <property name="lines">2</property>
                <property name="ellipsize">end</property>
                <property name="max-width-chars">14</property>
                <property name="width-chars">10</property>
                <property name="xalign">0.5</property>
                <style>
                  <class name="item-name"/>
                  <class name="item-text"/>
                  <class name="grid-item-name"/>
                </style>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">1</property>
              </packing>
            </child>
            <child>
              <object class="GtkLabel" id="item-shortcut">
                <property name="name">item-shortcut</property>
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="margin-top">2</property>
                <property name="halign">center</property>
                <property name="justify">center</property>
                <property name="label">Alt+1</property>
                <property name="xalign">0.5</property>
                <style>
                  <class name="item-shortcut"/>
                  <class name="item-text"/>
                  <class name="grid-item-shortcut"/>
                </style>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">2</property>
              </packing>
            </child>
            <style>
              <class name="item-container"/>
              <class name="grid-item-container"/>
            </style>
          </object>
        </child>
        <style>
          <class name="item-box"/>
          <class name="grid-item-box"/>
        </style>
      </object>
    </child>
    <style>
      <class name="item-frame"/>
      <class name="grid-item-frame"/>
    </style>
  </object>
</interface>
